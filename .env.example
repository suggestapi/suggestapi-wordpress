# Copy to .env and edit. Compose works without it (defaults target the demo index).
WP_PORT=8080

WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress
MARIADB_ROOT_PASSWORD=localdev

WP_URL=http://localhost:8080
WP_TITLE=SuggestAPI Test
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin1234!
WP_ADMIN_EMAIL=admin@example.com

# Demo search key (browser-safe, from suggestapi.com/examples/ecommerce).
# Private write key (server-only) comes from the SuggestAPI dashboard — same
# account/index as the public key. Required for catalog sync; search works alone.
# Required for live tests (public search key from the SuggestAPI dashboard).
SUGGESTAPI_PUBLIC_KEY=
SUGGESTAPI_PRIVATE_KEY=
SUGGESTAPI_INDEX=ecommerce

# Agent discovery (ai-catalog link tag in theme <head>)
# Agent catalog: https://agent.suggestapi.com/catalogs/{site-domain}/ai-catalog.json
SUGGESTAPI_AGENT_EMBED=1

# Set to 0 to skip WooCommerce (sync stays dormant without it).
INSTALL_WOO=1

# Background sync (needs a private write key to actually push; demo key is read-only)
SUGGESTAPI_SYNC_ENABLED=1
SUGGESTAPI_INCLUDE_DRAFTS=0
SUGGESTAPI_BATCH_SIZE=100
SUGGESTAPI_REINDEX_CHUNK=500
# Show SuggestAPI search box above the WooCommerce shop grid
SUGGESTAPI_SHOP_SEARCH=1
